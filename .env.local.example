# =============================================================================
# REQUIRED Environment Variables
# =============================================================================
# These MUST be set for the application to work

# JWT Secret Key - Used for signing and verifying authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=local-dev-secret-change-in-production

# DynamoDB Table Names
DEVICES_TABLE=SensorApi-Devices
READINGS_TABLE=SensorApi-Readings
USERS_TABLE=SensorApi-Users
AUTH_TABLE=SensorApi-Auth

# AWS Region
AWS_REGION=us-east-1

# =============================================================================
# OPTIONAL Environment Variables
# =============================================================================

# Set to 'true' when using DynamoDB Local (Docker)
IS_LOCAL=true

# Node environment (development | production | test)
NODE_ENV=development
