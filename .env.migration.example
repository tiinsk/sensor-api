# Copy to .env.migration and fill in. Used by: npm run migrate:pg-to-dynamodb
# PostgreSQL (required). If the DB is on a remote server (e.g. DigitalOcean), open an SSH tunnel first in another terminal:
#   ssh -L 5432:localhost:5432 user@your-server-ip
# Then use localhost in the connection string below (the tunnel forwards localhost:5432 to the remote DB).
PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/your_database

# AWS (required). Region and credentials (e.g. aws configure)
AWS_REGION=us-east-1

# Set to 'true' when using DynamoDB Local (Docker)
USE_LOCAL_DB=true

# Node environment (development | production | test)
NODE_ENV=development

JWT_SECRET=local-dev-secret-change-in-production

