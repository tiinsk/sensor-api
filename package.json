{
  "name": "sensor-api",
  "version": "1.0.0",
  "description": "Sensor API - AWS Lambda + DynamoDB",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cdk": "cd cdk && cdk",
    "cdk:synth": "cd cdk && cdk synth",
    "cdk:deploy": "cd cdk && cdk deploy --all",
    "cdk:diff": "cd cdk && cdk diff",
    "cdk:destroy": "cd cdk && cdk destroy --all",
    "dynamodb:start": "docker compose up -d",
    "dynamodb:stop": "docker compose down",
    "tables:create": "node dist/scripts/create-tables-local.js",
    "seed:local": "node dist/scripts/seed-local.js"
  },
  "author": "Tiina Koskiranta",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
