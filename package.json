{
  "name": "sensor-api",
  "version": "1.0.0",
  "description": "Sensor API - AWS Lambda + DynamoDB",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/bundle/index.js --external:@aws-sdk/* --external:aws-sdk",
    "cdk": "cd cdk && cdk",
    "cdk:synth": "cd cdk && cdk synth --context jwtSecretName=sensor-api/jwt-secret --context allowedOriginsParamName=/sensor-api/allowed-origins",
    "cdk:deploy": "cd cdk && cdk deploy --all --context jwtSecretName=sensor-api/jwt-secret --context allowedOriginsParamName=/sensor-api/allowed-origins",
    "cdk:diff": "cd cdk && cdk diff",
    "cdk:destroy": "cd cdk && cdk destroy --all",
    "dynamodb:start": "docker compose up -d",
    "dynamodb:stop": "docker compose down",
    "tables:create": "dotenv -c -- node_modules/.bin/ts-node scripts/create-tables-local.ts",
    "seed:local": "dotenv -c -- node_modules/.bin/ts-node scripts/seed-local.ts",
    "sam:env": "dotenv -c -- node_modules/.bin/ts-node scripts/generate-sam-env.ts",
    "create:user": "dotenv -c -- node_modules/.bin/ts-node scripts/create-user.ts",
    "create:api-key": "dotenv -c -- node_modules/.bin/ts-node scripts/create-api-key.ts",
    "create:user:prod": "dotenv -e .env.production -- node_modules/.bin/ts-node scripts/create-user.ts",
    "create:api-key:prod": "dotenv -e .env.production -- node_modules/.bin/ts-node scripts/create-api-key.ts",
    "migrate:pg-to-dynamodb": "dotenv -e .env.migration -- node_modules/.bin/ts-node scripts/migrate-pg-to-dynamodb.ts",
    "sam:local": "dotenv -c -- bash -c 'npm run sam:env && npm run build:watch & sam local start-api --host 0.0.0.0 --env-vars env.json --warm-containers EAGER --docker-network sensor-api_default --port ${LOCAL_API_PORT:-3000} & npm run bundle -- --watch'",
    "sam:test": "NODE_ENV=test dotenv -c -- bash -c 'npm run sam:env && npm run build:watch & sam local start-api --env-vars env.json --warm-containers EAGER --docker-network sensor-api_default --port ${TEST_API_PORT:-3000} & npm run bundle -- --watch'",
    "sam:invoke": "npm run sam:env && sam local invoke SensorApiFunction --env-vars env.json --event events/test-event.json",
    "test": "NODE_ENV=test dotenv -c -- jest",
    "test:watch": "NODE_ENV=test dotenv -c -- jest --watch",
    "test:setup": "NODE_ENV=test dotenv -c -- node_modules/.bin/ts-node scripts/setup-integration-tests.ts",
    "test:compatibility": "NODE_ENV=test dotenv -c -- jest tests/compatibility",
    "test:integration": "NODE_ENV=test dotenv -c -- jest tests/integration",
    "test:unit": "NODE_ENV=test dotenv -c -- jest tests/unit"
  },
  "author": "Tiina Koskiranta",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-secrets-manager": "^3.709.0",
    "@aws-sdk/client-ssm": "^3.1070.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "aws-cdk-lib": "^2.170.0",
    "bcryptjs": "^3.0.3",
    "constructs": "^10.4.2",
    "date-fns-tz": "^3.2.0",
    "dotenv-cli": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "lambda-api": "^1.0.3",
    "prompts": "^2.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
